Jméno sítě:
    SmartLamp

Komentář:
    Lamp controller with manual button, auto-off and blinking mode

Vstupy:
    btn
    sensor

Výstupy:
    led

Proměnné:
    int mode = 0
    int counter = 0

Místa:
    OFF (1)
    ON (0)
    BLINK (0)
    WAIT (0)

Přechody:

T_btn_toggle :
    in: OFF*1
    out: ON*1
    when: btn [ ]
    do: { mode = 1; output("led", "ON"); }

T_btn_off :
    in: ON*1
    out: OFF*1
    when: btn [ ]
    do: { mode = 0; output("led", "OFF"); }

T_auto_off :
    in: ON*1
    out: OFF*1
    when: sensor [ ]
    do: { output("led", "OFF"); }

T_to_blink :
    in: ON*1
    out: BLINK*1
    when: sensor [ ]
    do: { mode = 2; counter = 0; }

T_blink_tick :
    in: BLINK*1
    out: BLINK*1
    when: [counter < 10] @ 1000
    do: {
        counter = counter + 1;
        if (counter % 2 == 0)
            output("led", "ON");
        else
            output("led", "OFF");
    }

T_blink_stop :
    in: BLINK*1
    out: OFF*1
    when: [counter >= 10]
    do: {
        output("led", "OFF");
    }